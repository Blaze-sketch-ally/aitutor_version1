# Copy to .env and fill in real values. Never commit .env itself
# (already covered by the repo's .gitignore).

# ----------------------------------
# Supabase
# ----------------------------------
# Project Settings -> Data API -> Project URL
SUPABASE_URL=
# Project Settings -> Data API -> Project API keys -> service_role
# (starts with "sb_secret_..." on newer projects). SERVER-SIDE ONLY --
# never expose this to the Next.js frontend. database/supabase_client.py
# uses this key, which bypasses Row Level Security by design; the
# FastAPI/service layer (auth/jwt_bearer.py + memory/session_manager.py)
# is the real authorization boundary, not RLS.
SUPABASE_KEY=
# Project Settings -> Data API -> JWT Settings -> "Legacy JWT Secret".
# Only required if this Supabase project signs auth tokens with the
# legacy shared HS256 secret -- projects on the newer asymmetric
# signing keys (JWKS) don't need this; auth/jwt_bearer.py detects which
# mode applies per-token automatically.
SUPABASE_JWT_SECRET=

# ----------------------------------
# CORS
# ----------------------------------
# Comma-separated list of origins allowed to call this API. Defaults to
# localhost:3000 if unset, so local dev needs no change. Set this to
# your real Vercel URL before deploying, e.g.:
#   CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=

# ----------------------------------
# LLM / model providers
# ----------------------------------
# GROQ_APIKEY is the canonical name for every Groq client (text, vision,
# video/Whisper transcription). GROQ_API_KEY is still read as a
# deprecated fallback, with a warning -- don't set both.
GROQ_APIKEY=
HF_TOKEN=

# Model ids -- non-secret, safe to change anytime. Leave unset to use
# the in-code defaults in models/config.py. Groq retires models
# regularly; check the account's model list if calls start failing.
# TEXT_MODEL: everything the student reads (answers, notes, quizzes,
#   comparisons, diagrams, chat). Default openai/gpt-oss-120b.
# FAST_MODEL: small internal steps (ambiguous-intent classification,
#   follow-up rewriting, conversation-memory summaries, keyword
#   extraction). Default openai/gpt-oss-20b. On Groq each model has its
#   own rate limits, so this also keeps that traffic off TEXT_MODEL's
#   daily token quota.
# VISION_MODEL: must accept image input (gpt-oss models do not).
TEXT_MODEL=
FAST_MODEL=
VISION_MODEL_PROVIDER=
VISION_MODEL=

# ----------------------------------
# External services
# ----------------------------------
YOUTUBE_API_KEY=
TAVILY_API_KEY=

# ----------------------------------
# LangSmith tracing (optional)
# ----------------------------------
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGCHAIN_PROJECT=

# ----------------------------------
# Attachment limits (optional, in-code defaults apply if unset)
# ----------------------------------
MAX_IMAGE_SIZE_MB=
MAX_IMAGES_PER_MESSAGE=
