NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth (Project Settings -> Data API -> Project URL / anon public key).
# The anon key is safe to expose in the browser — it has no privileges beyond
# what Row Level Security grants. Never put the service-role/secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
